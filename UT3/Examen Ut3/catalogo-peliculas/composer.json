{
    "name": "docencia/examen-ut3-catalogo-peliculas",
    "description": "Examen DWES UT3 de formularios, objetos, archivos y PHPUnit",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Soporte/formularios.php",
            "src/Soporte/archivos.php",
            "src/Soporte/html.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
